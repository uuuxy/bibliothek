# Dependency directories
node_modules/
frontend/node_modules/
# Verirrtes Python-venv (Projekt nutzt kein Python) — explizit, damit nie ein
# ~130-MB-venv versehentlich committet wird.
.venv/

# Build outputs
dist/
frontend/dist/
frontend/dist-ssr/

# Kompilierte Go-Binaries im Repo-Root (root-verankert, damit cmd/-Pakete unberührt bleiben)
#
# Die Liste folgt cmd/. Gebaut werden die Werkzeuge im Image (Dockerfile), nicht im
# Arbeitsverzeichnis.
/bibliothek
/encrypt-backup
/littera-altbestand
/littera-import
/migrate
/restore-backup
/rotate-encryption-key
/seed

# User uploads & data
uploads/

# Editor-Sicherungen wie docker-compose.yml.save und .env.save entstehen ungefragt und
# tragen denselben Inhalt wie das Original — bei .env.save also JWT_SECRET, SMTP_PASSWORD
# und POSTGRES_PASSWORD im Klartext.
*.save
*.save.[0-9]*

# Environment configurations
#
# Erlaubnisliste statt Aufzählung: Alles, was .env heißt, ist ignoriert, und nur
# .env.example ist ausgenommen. Eine Aufzählung (.env.bak*, .env.backup* …) deckte nur die
# Namen ab, an die jemand gedacht hat; ein Editor legt .env.save, .env.save.1 … an, und
# ein `git add .` schöbe sie mit allen Geheimnissen in ein öffentliches Repository.
.env*
!.env.example
*.local
frontend/*.local

# Lokale KI-/Tool-Konfiguration (Claude Code) — maschinenspezifische Permission-Allowlist,
# nicht teamweit geteilt. Die eigentlichen Git-Hooks liegen in scripts/git-hooks/.
.claude/*
!.claude/settings.json

# OS Metadata
.DS_Store
Thumbs.db

# Database Backups & Archives
#
# Die *.sql-Regel greift nur bei der Endung .sql; die Sicherungen heißen .sql.gz und
# .sql.gz.enc. update.sh und scripts/backup.sh legen sie in backups/ ab, im Ausnahmefall
# auch im Klartext, und jede enthält die komplette schueler-Tabelle: Klarnamen, Adressen
# und Ausleihhistorie von Minderjährigen (siehe die Warnung in
# docs/resilience_and_recovery.md, Abschnitt 1b). Auch verschlüsselt gehören sie nicht
# in ein öffentliches Repository.
*.sql
!schema.sql
!migrations/
!migrations/*.sql
# Eingefrorene historische Baseline für den Schema-Paritätstest — reines DDL
# (das schema.sql von Commit e5740b95), keine Daten. Bewusst nur diese EINE Datei.
!db/testdata/schema_baseline_e5740b95.sql
backups/
*.sql.gz
*.sql.gz.enc
# Arbeitsdateien der Wiederherstellung und der Schlüsselwechsel
# (docs/resilience_and_recovery.md 2a/2c, docs/SECURITY.md). Sie entstehen im
# Wurzelverzeichnis und tragen denselben Klartext wie die Dumps.
/vor-restore.sql
/wiederherstellung.sql
/vor-pw-wechsel.sql
/vor-rotation.sql
*.zip

certs/

# Temp build, logs, and diffs
*build.log
test.log
tmp_build
*.diff
frontend_build.log
build.log

tmp/

# Generierte Security-/Lint-Scan-Reports im Repo-Root (security-scan.sh etc.).
# Kuratierte Audit-Belege unter docs/security/ bleiben bewusst versioniert.
/*_report.txt
/*_report.html
/*_report.json
/gosec.json
frontend/lint_results.json
*.log
!scripts/*.sql

# SonarQube-Scan-Artefakte (lokal, nicht versioniert)
.scannerwork/
/sonarqube_*.json
/issues_page_*.json
docker-compose.grafana.yml
prometheus.yml
grafana-provisioning/

# ─────────────────────────────────────────────────────────────────────────────
# Littera-Altbestand: enthält Schülerdaten (Namen, Geburtsdaten, Adressen)
# ─────────────────────────────────────────────────────────────────────────────
# Diese Dateien gehören AUSSCHLIESSLICH auf den lokalen Rechner. Der Lesepfad
# (internal/littera) arbeitet mit CSV-Exporten aus mdb-export; sein Lauf gegen
# echte Daten hängt an LITTERA_CSV_DIR und zeigt bewusst auf ein Verzeichnis
# ausserhalb des Projekts. Testfixtures im Code sind erfundene Namen.
*.mdb
*.accdb
littera*.csv
leser*.csv
exemplar*.csv
titel*.csv
personen*.csv

# Coverage-Report für den SonarQube-Scan (scripts/sonar_scan.sh)
coverage.out
# Frontend-Coverage (lcov fuer SonarQube, erzeugt von scripts/sonar_scan.sh)
frontend/coverage/

# Playwright-Ausgabe, wenn aus dem Repo-Root gestartet (frontend/.gitignore greift dort nicht)
test-results/
scripts/demo-video/

# Ausgaben von security-scan.sh im Wurzelverzeichnis.
zap_openapi.json
zap_api_report.html
