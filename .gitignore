# Dependency directories
node_modules/
frontend/node_modules/
# Verirrtes Python-venv (Projekt nutzt kein Python) — explizit, damit nie ein
# ~130-MB-venv versehentlich committet wird.
.venv/

# Build outputs
dist/
frontend/dist/
frontend/dist-ssr/

# Kompilierte Go-Binaries im Repo-Root (root-verankert, damit cmd/-Pakete unberührt bleiben)
/bibliothek
/migrate
/migrate_photos
/restore-backup

# User uploads & data
uploads/

# Environment configurations
#
# Erlaubnisliste statt Aufzählung: ALLES was .env heißt ist ignoriert, und nur
# .env.example ist ausgenommen. Umgekehrt herum war es eine Aufzählung von
# .env.bak*/.env.backup*/.env.*.bak — die deckte genau die Namen ab, an die jemand
# gedacht hatte.
#
# Auf der Produktion lagen am 06.08.2026 drei Dateien, an die niemand gedacht hatte:
# .env.save, .env.save.1 und .env.save.2 (angelegt von einem Editor), jede mit
# JWT_SECRET, SMTP_PASSWORD und POSTGRES_PASSWORD im Klartext. `git status` führte
# sie als untracked — ein `git add .` hätte sie in ein öffentliches Repository
# geschoben.
#
# Eine Ausnahmeliste schützt nur vor dem, was man beim Schreiben schon kannte.
.env*
!.env.example
*.local
frontend/*.local

# Lokale KI-/Tool-Konfiguration (Claude Code) — maschinenspezifische Permission-Allowlist,
# nicht teamweit geteilt. Die eigentlichen Git-Hooks liegen in scripts/git-hooks/.
.claude/

# OS Metadata
.DS_Store
Thumbs.db

# Database Backups & Archives
*.sql
!schema.sql
!migrations/
!migrations/*.sql
*.zip

certs/

# Temp build, logs, and diffs
*build.log
test.log
tmp_build
*.diff
frontend_build.log
build.log

tmp/

# Generierte Security-/Lint-Scan-Reports im Repo-Root (security-scan.sh etc.).
# Kuratierte Audit-Belege unter docs/security/ bleiben bewusst versioniert.
/*_report.txt
/*_report.html
/*_report.json
/gosec.json
frontend/lint_results.json
*.log
!scripts/*.sql

# SonarQube-Scan-Artefakte (lokal, nicht versioniert)
.scannerwork/
/sonarqube_*.json
/issues_page_*.json
docker-compose.grafana.yml
prometheus.yml
grafana-provisioning/

# ─────────────────────────────────────────────────────────────────────────────
# Littera-Altbestand: enthält Schülerdaten (Namen, Geburtsdaten, Adressen)
# ─────────────────────────────────────────────────────────────────────────────
# Diese Dateien gehören AUSSCHLIESSLICH auf den lokalen Rechner. Der Lesepfad
# (internal/littera) arbeitet mit CSV-Exporten aus mdb-export; sein Lauf gegen
# echte Daten hängt an LITTERA_CSV_DIR und zeigt bewusst auf ein Verzeichnis
# ausserhalb des Projekts. Testfixtures im Code sind erfundene Namen.
*.mdb
*.accdb
littera*.csv
leser*.csv
exemplar*.csv
titel*.csv
personen*.csv

# Coverage-Report für den SonarQube-Scan (scripts/sonar_scan.sh)
coverage.out

# Swagger: nur docs.go wird ausgeliefert (der Server bettet es ein). swagger.json/yaml
# sind Nebenprodukte derselben Generierung und würden bei jedem Lauf Diff-Rauschen erzeugen.
docs/swagger.json
docs/swagger.yaml
