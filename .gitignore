# Dependency directories
node_modules/
frontend/node_modules/
# Verirrtes Python-venv (Projekt nutzt kein Python) — explizit, damit nie ein
# ~130-MB-venv versehentlich committet wird.
.venv/

# Build outputs
dist/
frontend/dist/
frontend/dist-ssr/

# Kompilierte Go-Binaries im Repo-Root (root-verankert, damit cmd/-Pakete unberührt bleiben)
/bibliothek
/migrate
/migrate_photos
/restore-backup

# User uploads & data
uploads/

# Editor-Sicherungen. docker-compose.yml.save und .env.save entstanden auf der
# Produktion ungefragt und tragen denselben Inhalt wie das Original — im Fall von
# .env.save hieß das: JWT_SECRET, SMTP_PASSWORD und POSTGRES_PASSWORD im Klartext.
*.save
*.save.[0-9]*

# Environment configurations
#
# Erlaubnisliste statt Aufzählung: ALLES was .env heißt ist ignoriert, und nur
# .env.example ist ausgenommen. Umgekehrt herum war es eine Aufzählung von
# .env.bak*/.env.backup*/.env.*.bak — die deckte genau die Namen ab, an die jemand
# gedacht hatte.
#
# Auf der Produktion lagen am 06.08.2026 drei Dateien, an die niemand gedacht hatte:
# .env.save, .env.save.1 und .env.save.2 (angelegt von einem Editor), jede mit
# JWT_SECRET, SMTP_PASSWORD und POSTGRES_PASSWORD im Klartext. `git status` führte
# sie als untracked — ein `git add .` hätte sie in ein öffentliches Repository
# geschoben.
#
# Eine Ausnahmeliste schützt nur vor dem, was man beim Schreiben schon kannte.
.env*
!.env.example
*.local
frontend/*.local

# Lokale KI-/Tool-Konfiguration (Claude Code) — maschinenspezifische Permission-Allowlist,
# nicht teamweit geteilt. Die eigentlichen Git-Hooks liegen in scripts/git-hooks/.
.claude/

# OS Metadata
.DS_Store
Thumbs.db

# Database Backups & Archives
#
# Die *.sql-Regel gab es schon; sie greift aber NUR bei der Endung .sql. Die echten
# Sicherungen heißen .sql.gz und .sql.gz.enc und waren damit von keiner Regel erfasst.
#
# Auf der Produktion lagen am 06.08.2026 **82 Dateien mit 174 MB** in backups/ —
# unverschlüsselte pg_dumps, angelegt von update.sh vor jedem Deploy und von
# scripts/backup.sh. Jede enthält die komplette schueler-Tabelle: Klarnamen, Adressen
# und Ausleihhistorie von Minderjährigen (siehe die Warnung in
# docs/resilience_and_recovery.md, Abschnitt 1b). `git status` führte backups/ als
# untracked auf — ein `git add .` hätte diese Daten in ein öffentliches Repository
# geschoben. Die Doku wusste, dass die Dateien schutzbedürftig sind; .gitignore nicht.
*.sql
!schema.sql
!migrations/
!migrations/*.sql
# Eingefrorene historische Baseline für den Schema-Paritätstest — reines DDL
# (das schema.sql von Commit e5740b95), keine Daten. Bewusst nur diese EINE Datei.
!db/testdata/schema_baseline_e5740b95.sql
backups/
*.sql.gz
*.sql.gz.enc
# Arbeitsdateien der Wiederherstellung und der Schlüsselwechsel
# (docs/resilience_and_recovery.md 2a/2c, docs/SECURITY.md). Sie entstehen im
# Wurzelverzeichnis und tragen denselben Klartext wie die Dumps.
/vor-restore.sql
/wiederherstellung.sql
/vor-pw-wechsel.sql
/vor-rotation.sql
*.zip

certs/

# Temp build, logs, and diffs
*build.log
test.log
tmp_build
*.diff
frontend_build.log
build.log

tmp/

# Generierte Security-/Lint-Scan-Reports im Repo-Root (security-scan.sh etc.).
# Kuratierte Audit-Belege unter docs/security/ bleiben bewusst versioniert.
/*_report.txt
/*_report.html
/*_report.json
/gosec.json
frontend/lint_results.json
*.log
!scripts/*.sql

# SonarQube-Scan-Artefakte (lokal, nicht versioniert)
.scannerwork/
/sonarqube_*.json
/issues_page_*.json
docker-compose.grafana.yml
prometheus.yml
grafana-provisioning/

# ─────────────────────────────────────────────────────────────────────────────
# Littera-Altbestand: enthält Schülerdaten (Namen, Geburtsdaten, Adressen)
# ─────────────────────────────────────────────────────────────────────────────
# Diese Dateien gehören AUSSCHLIESSLICH auf den lokalen Rechner. Der Lesepfad
# (internal/littera) arbeitet mit CSV-Exporten aus mdb-export; sein Lauf gegen
# echte Daten hängt an LITTERA_CSV_DIR und zeigt bewusst auf ein Verzeichnis
# ausserhalb des Projekts. Testfixtures im Code sind erfundene Namen.
*.mdb
*.accdb
littera*.csv
leser*.csv
exemplar*.csv
titel*.csv
personen*.csv

# Coverage-Report für den SonarQube-Scan (scripts/sonar_scan.sh)
coverage.out
# Frontend-Coverage (lcov fuer SonarQube, erzeugt von scripts/sonar_scan.sh)
frontend/coverage/

# Swagger: nur docs.go wird ausgeliefert (der Server bettet es ein). swagger.json/yaml
# sind Nebenprodukte derselben Generierung und würden bei jedem Lauf Diff-Rauschen erzeugen.
docs/swagger.json
docs/swagger.yaml
