# Bibliotheks-System Environment Variables
# Copy this file to .env and fill in the values

# Server configuration
PORT=8081
# Secure-Flag der Sitzungs- und CSRF-Cookies. Vorgabe true, weil diese Vorlage mit
# APP_ENV=production ausgeliefert wird (siehe unten) und der Stack hinter Caddy-HTTPS
# läuft. Ein hier eingetragenes false wäre die stille Fehlannahme: Der Login
# funktionierte über HTTPS weiterhin tadellos, das Sitzungscookie ginge nur eben
# ohne Secure-Flag über die Leitung — auffallen würde das niemandem.
# NUR auf false setzen, wenn die Anwendung ausschließlich über HTTP im lokalen Netz
# erreichbar ist (dort sendet der Browser ein Secure-Cookie nicht mit).
COOKIE_SECURE=true
# Zeitzone des Servers/Containers. Fristen-Berechnungen pinnen Europe/Berlin
# bereits im Code; TZ hier hält darüber hinaus Logs/Timestamps konsistent.
TZ=Europe/Berlin

# Database configuration (für direkten `go run`-Betrieb gegen ein lokales Postgres)
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5433/bibliothek?sslmode=disable

# ── Docker-Compose-Stack (docker-compose.yml / docker-compose.local.yml) ──
# Diese Werte substituiert Docker Compose für den Postgres-Container und die daraus
# gebaute DATABASE_URL. POSTGRES_PASSWORD ist PFLICHT — es gibt bewusst kein
# committetes Default-Passwort mehr (secrets:S6698). Für lokale Entwicklung genügt
# ein beliebiger Wert; für Produktion ein starkes, einzigartiges Passwort setzen.
# Erststart:  cp .env.example .env
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local-dev
POSTGRES_DB=bibliothek

# Environment: "production" (Standard) oder "local"/"development".
# Steuert Cookie-Secure-Flag und Swagger-Sichtbarkeit (NICHT den Secret-Guard).
APP_ENV=production

# ── Reverse-Proxy / echte Client-IP ──────────────────────────────────────────
# Kommagetrennte CIDRs (oder einzelne IPs) der vertrauenswürdigen Proxies. Nur
# von diesen wird X-Forwarded-For geglaubt; von allen anderen (direkte Zugriffe)
# wird der Header ignoriert. Loopback ist immer zusätzlich vertraut.
#
# WARUM WICHTIG: Ohne diesen Wert sieht das Backend hinter Caddy bei JEDEM Request
# nur die eine Docker-Proxy-IP. Rate-Limiting und Login-Brute-Force-Schutz würden
# dann alle Nutzer als denselben Client behandeln — fünf Fehl-Logins irgendeines
# Nutzers sperren sonst ALLE für 15 Minuten aus (globaler DoS).
# docker-compose.yml setzt hierfür das private Docker-Netz als Default.
TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

# Harte Secret-Absicherung (Start-Verweigerung bei bekannten Default-Secrets).
# Test-/Pilotphase: false (Standard) — Stack startet auch mit Defaults.
# Vor echtem Prod-Deploy auf true setzen UND echte JWT_SECRET/APP_ENCRYPTION_KEY/
# POSTGRES_PASSWORD setzen + COOKIE_SECURE=true (hinter Caddy-HTTPS).
ENFORCE_PROD_SECRETS=false

# Security
JWT_SECRET=super-secret-key-that-is-at-least-32-bytes-long

# Initial Admin Bootstrapping (only used if users table is empty)
INITIAL_ADMIN_EMAIL=admin@bibliothek.local
INITIAL_ADMIN_PASSWORD=admin

# APP_ENCRYPTION_KEY must be exactly 32 bytes (or 64 hex characters) long
APP_ENCRYPTION_KEY=your-32-character-encryption-key

# ─────────────────────────────────────────────────────────────────────────────
# Automatische Backups (täglicher Cron-Job, jobs.RunDatabaseBackup)
# ─────────────────────────────────────────────────────────────────────────────
# ACHTUNG: Ohne BACKUP_ENCRYPTION_KEY überspringt sich der Backup-Job — es laufen
# dann KEINE automatischen Backups! Vor Go-Live zwingend setzen (>= 32 Zeichen).
# Mit genau diesem Schlüssel wird via cmd/restore-backup wiederhergestellt
# (siehe docs/resilience_and_recovery.md).
#
# Ganz still ist der Ausfall nicht mehr: /api/admin/system/backup-status meldet
# "critical", sobald der Schlüssel fehlt oder das jüngste Backup älter als 48 h ist;
# das Admin-Dashboard zeigt das als Alert. Der Schlüssel allein genügte allerdings
# lange nicht — bis zum Audit fehlte pg_dump im Container-Image, und damit konnte
# überhaupt kein Backup entstehen (jetzt behoben: postgresql-client im Dockerfile).
BACKUP_ENCRYPTION_KEY=
# Zielverzeichnis der verschlüsselten Backups (Standard: ./backups)
# Im Docker-Betrieb zeigt die Vorgabe auf /app/backups (benanntes Volume) — siehe
# docker-compose.yml. Compose reicht ohne env_file NUR die dort gelisteten Schlüssel
# durch; BACKUP_ENCRYPTION_KEY und BACKUP_DIR stehen deshalb ausdrücklich im
# environment-Block. Fehlen sie dort, hilft der beste Wert in dieser Datei nichts.
BACKUP_DIR=./backups

# ─────────────────────────────────────────────────────────────────────────────
# IMAP-Anmeldung (Login prüft Zugangsdaten gegen den Schul-Mailserver)
# ─────────────────────────────────────────────────────────────────────────────
# IMAP_HOST ist PFLICHT — ohne die Variable startet der Server nicht mehr. Früher
# fiel der Code still auf imap.philipp-reis-schule.de:993 zurück; ein "go run" ohne
# Umgebung sprach damit unbemerkt den Produktiv-Mailserver der Schule an.
#
# IMAP_HOST=mock akzeptiert JEDES Passwort für jede in benutzer eingetragene
# E-Mail — das ist keine Bequemlichkeit, das ist die Authentifizierung aus. Erlaubt
# nur zusammen mit APP_ENV=local/development/test; in jeder anderen Umgebung
# verweigert der Server den Start.
IMAP_HOST=mock
IMAP_PORT=993

# Selbstanmeldung: Wer sich mit einem Mailkonto DIESER Domain erstmals anmeldet, bekommt
# einen INAKTIVEN Eintrag — anmelden kann er sich damit nicht. Die Bibliothek sieht das
# Konto in der Benutzerverwaltung und schaltet es frei.
#
# LEER = abgeschaltet (Vorgabe). Dann legt Konten ausschliesslich die Benutzerverwaltung
# an, so wie bisher. Der Serverstart protokolliert, welcher Zustand gilt.
#
# Bewusst eine Domain und kein Ja/Nein-Schalter: Ohne Einschraenkung entschiede der
# Mailserver, wer ins Bibliothekssystem darf. Die Domain macht die Bedingung sichtbar.
SELBSTANMELDUNG_DOMAIN=

# Optionaler Offsite-Upload der Backups nach S3 (nur aktiv, wenn alle vier gesetzt sind)
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_USE_SSL=true

# ─────────────────────────────────────────────────────────────────────────────
# Produktionsbetrieb
# ─────────────────────────────────────────────────────────────────────────────
# Erzwingt die Ziel-Domain im HTTPS-Redirect (sonst Fallback auf den Request-Host).
# Hinter Caddy-HTTPS auf die öffentliche URL setzen, z. B. https://bibliothek.schule.de
ALLOWED_ORIGIN=

# Nur für Legacy-SMTP-Server mit selbstsigniertem Zertifikat (Default: sichere Verifikation).
# SMTP_ALLOW_INSECURE_TLS=true
# Optionales Sentry-Error-Reporting.
# SENTRY_DSN=

