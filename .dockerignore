.git
.gitignore
.vscode
node_modules
frontend/node_modules
frontend/dist
dist
*.log
uploads/
/main
/dev/null
tmp
.gemini
# backups/ und .env gehören nicht in den Build-Kontext: Jeder ./update.sh reicht den
# Kontext an den Docker-Daemon (BuildKit-Cache auf derselben Platte), und backups/ wächst
# mit jedem Deploy. .gitignore führt beide aus demselben Grund.
backups/
.env
.env.*
!.env.example
