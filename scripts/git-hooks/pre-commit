#!/bin/bash
# pre-commit hook

# Farben für Output
RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color

echo "================================================"
echo "⚡ PRE-COMMIT HOOK: Starte schnelle Code-Checks..."
echo "================================================"

# 1. Formatierung (beide Baeume)
# Beide hatten ein Format-Werkzeug und keinen Prueflauf — und beide waren abgedriftet
# (8 Dateien im Frontend, 11 im Backend, Stand 07.08.2026). Formatierungsrauschen in
# einem Diff kostet bei JEDEM spaeteren Review Aufmerksamkeit, die dem Inhalt fehlt.
echo "[1/3] Prüfe Formatierung (prettier + gofmt)..."
cd frontend || exit 1
if ! npx prettier --check src/ e2e/ --log-level warn; then
    echo -e "${RED}✗ Frontend nicht formatiert. Beheben: cd frontend && npm run format${NC}"
    exit 1
fi
cd ..
UNFORMATIERT=$(gofmt -l $(find . -name '*.go' -not -path './vendor/*' -not -path './docs/*') 2>/dev/null)
if [ -n "$UNFORMATIERT" ]; then
    echo -e "${RED}✗ Backend nicht formatiert. Beheben: gofmt -w <Datei>${NC}"
    echo "$UNFORMATIERT"
    exit 1
fi
echo -e "${GREEN}✓ Formatierung bestanden.${NC}"

# 2. ESLint (Frontend)
#
# OHNE --quiet und mit --max-warnings 0. Der Schalter unterdrückte Warnungen komplett,
# und weil ESLint sonst nirgends automatisch lief (CI fährt im Frontend nur Vitest),
# war eine Warnung damit unsichtbar — nicht "niedrig priorisiert", sondern nirgends zu
# sehen. Am 10.08.2026 kam so heraus, dass ein Snippet in StatsDashboard.svelte die
# übergebene Icon-Größe seit dem 27.07. verwirft: zwei Wochen lang gemeldet, zwei
# Wochen lang verschluckt.
#
# Eine Warnung, die niemand je zu Gesicht bekommt, ist keine Warnung. Entweder sie
# blockiert, oder die Regel gehört abgeschaltet — beides ist ehrlicher als ein
# Werkzeug, das im Stillen recht behält.
echo "[2/3] Führe ESLint (Frontend) aus..."
cd frontend || exit 1
if npx eslint . --max-warnings 0; then
    echo -e "${GREEN}✓ ESLint bestanden.${NC}"
else
    echo -e "${RED}✗ ESLint fehlgeschlagen! Bitte Fehler im Frontend beheben.${NC}"
    exit 1
fi
cd ..

# 3. golangci-lint (Backend)
echo "[3/3] Führe golangci-lint (Backend) aus..."
if golangci-lint run ./...; then
    echo -e "${GREEN}✓ golangci-lint bestanden.${NC}"
else
    echo -e "${RED}✗ golangci-lint fehlgeschlagen! Bitte Fehler im Backend beheben.${NC}"
    exit 1
fi

echo -e "${GREEN}✅ Alle Pre-Commit Checks bestanden! Commit wird erstellt.${NC}"
exit 0
