#!/bin/bash
# pre-push hook

# Füge Go-Bin-Verzeichnis zum PATH hinzu, damit govulncheck immer gefunden wird
export PATH="$PATH:$(go env GOPATH)/bin"

# Farben für Output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo "======================================================"
echo "🛡️ PRE-PUSH HOOK: Starte Tests & Security-Scans..."
echo "======================================================"

# 1. Go Tests
echo "[1/6] Führe Go Tests aus..."
if go test ./...; then
    echo -e "${GREEN}✓ Go Tests bestanden.${NC}"
else
    echo -e "${RED}✗ Go Tests fehlgeschlagen! Push abgebrochen.${NC}"
    exit 1
fi

# Wie viele Tests hat dieser Lauf gar nicht ausgeführt?
#
# Die DB-Integrationstests (*_pg_test.go) hängen an TEST_DATABASE_URL und überspringen
# sich ohne sie — STILL, mit grünem "ok" daneben. Am 10.08.2026 stand deshalb acht
# Stunden lang ein Test auf main, der genau das Gegenteil der geltenden Entscheidung
# behauptete (KOLLEGIUM muss perform_actions behalten, während der Seed es bewusst
# entzieht). Gemerkt hat es niemand: Lokal übersprang er sich, und in CI fiel er in
# einen Lauf, in den keiner mehr geschaut hat.
#
# Der Hook fängt das nicht auf — dafür müsste er ein Postgres hochziehen, und das
# gehört nicht in einen Push. Er sagt aber, was er NICHT geprüft hat. Ein Gate, das
# seine eigene blinde Stelle verschweigt, ist schlimmer als keins.
#
# Gezählt werden die Dateien, nicht die Skips: Ohne -v druckt `go test` keine
# Skip-Gründe, ein Zähler auf der Ausgabe stünde immer auf 0 — ein Wächter, der sich
# selbst blind misst.
PG_DATEIEN=$(find . -name '*_pg_test.go' -not -path './node_modules/*' 2>/dev/null | wc -l | tr -d ' ')
if [ -z "${TEST_DATABASE_URL:-}" ] && [ "${PG_DATEIEN:-0}" -gt 0 ]; then
    echo -e "${YELLOW}⚠ ${PG_DATEIEN} Datei(en) mit DB-Integrationstests wurden NICHT ausgeführt — TEST_DATABASE_URL ist nicht gesetzt.${NC}"
    echo -e "${YELLOW}  Sie prüfen echtes SQL (Rechte-Seed, LUSD-Import, Backup-Restore). CI führt sie aus.${NC}"
    echo -e "${YELLOW}  Lokal mitlaufen lassen — der Entwicklungs-Stack bringt Postgres schon mit.${NC}"
    # Einmalig, danach existiert die Datenbank. Bewusst OHNE spitze Klammern: Ein
    # Platzhalter in einer Copy-Paste-Zeile hat auf diesem Projekt schon einmal die
    # Produktion umgelegt. Das Passwort holt sich der Befehl selbst aus der .env.
    echo -e "${YELLOW}    docker exec -i bibliothek-db-local psql -U postgres -c 'CREATE DATABASE bibliothek_test;'${NC}"
    echo '    TEST_DATABASE_URL="postgres://postgres:$(grep "^POSTGRES_PASSWORD=" .env | cut -d= -f2-)@127.0.0.1:5434/bibliothek_test?sslmode=disable" go test ./...'
fi

# 2. Typpruefung Frontend (svelte-check)
# jsconfig.json setzt checkJs, und 200 von 256 Dateien tragen JSDoc-Typen — bis zum
# 07.08.2026 hat die aber NIEMAND geprueft. Der erste Lauf fand 64 Meldungen, darunter
# einen Typ, der seit Migration 066 falsch war (Supplier ohne ist_hauptlieferant).
echo "[2/6] Führe svelte-check (Frontend-Typen) aus..."
cd frontend || exit 1
if npm run --silent check; then
    echo -e "${GREEN}✓ svelte-check bestanden.${NC}"
else
    echo -e "${RED}✗ svelte-check fehlgeschlagen! Push abgebrochen.${NC}"
    exit 1
fi
cd ..

# 2b. Vitest — die Frontend-Unit-Tests. Bis 26.08.2026 liefen sie NUR in der CI:
# Ein Push, der menu.test.js rot machte (Türliste am Menüpunkt „Einstellungen" hinkte
# kategorien.js hinterher), kam durch alle lokalen Gates und stand zwei Läufe lang als
# rotes main da. 14 Sekunden hier sparen den roten Haken dort.
echo "[2b/6] Führe Vitest (Frontend-Unit-Tests) aus..."
cd frontend || exit 1
if npx vitest run --silent >/dev/null 2>&1; then
    echo -e "${GREEN}✓ Vitest bestanden.${NC}"
else
    echo -e "${RED}✗ Vitest fehlgeschlagen! Push abgebrochen. (npx vitest run im Ordner frontend zeigt die Stelle.)${NC}"
    exit 1
fi
cd ..

# 3. npm audit (Frontend Dependency Security)
echo "[3/6] Führe npm audit (Frontend) aus..."
cd frontend || exit 1
if npm audit; then
    echo -e "${GREEN}✓ npm audit bestanden.${NC}"
else
    echo -e "${YELLOW}⚠ npm audit hat Schwachstellen gefunden! Bitte prüfen (Push geht weiter, da audit oft false-positives hat).${NC}"
fi
cd ..

# 4. govulncheck (Backend Dependency Security)
echo "[4/6] Führe govulncheck (Backend) aus..."
if command -v govulncheck &> /dev/null; then
    if govulncheck ./...; then
        echo -e "${GREEN}✓ govulncheck bestanden.${NC}"
    else
        echo -e "${RED}✗ govulncheck fehlgeschlagen! Kritische Backend-Schwachstellen gefunden.${NC}"
        exit 1
    fi
else
    echo -e "${YELLOW}⚠ govulncheck nicht installiert. Überspringe Scan. (go install golang.org/x/vuln/cmd/govulncheck@latest)${NC}"
fi

# 5. Trivy (Container Security)
echo "[5/6] Führe Trivy (Container) aus..."
if command -v trivy &> /dev/null; then
    if [ -f "Dockerfile" ]; then
        if trivy config Dockerfile; then
            echo -e "${GREEN}✓ Trivy Config Scan bestanden.${NC}"
        else
            echo -e "${RED}✗ Trivy Config Scan fehlgeschlagen! Dockerfile weist Fehler auf.${NC}"
            exit 1
        fi
    else
        echo -e "${YELLOW}⚠ Kein Dockerfile gefunden. Überspringe Trivy Scan.${NC}"
    fi
else
    echo -e "${YELLOW}⚠ trivy nicht installiert. Überspringe Scan.${NC}"
fi

# 6. deadcode (unerreichbarer Code)
# Logik in scripts/deadcode_gate.sh — dort steht auch, warum es dieses Gate gibt.
echo "[6/6] Führe deadcode (unerreichbarer Code) aus..."
if ./scripts/deadcode_gate.sh; then
    echo -e "${GREEN}✓ deadcode: kein unerreichbarer Code.${NC}"
else
    # Das Skript nennt den Grund selbst (unerreichbarer Code ODER Werkzeug fehlt)
    # und schreibt ihn nach stderr. Es überspringt sich bewusst NIE still.
    echo -e "${RED}✗ deadcode-Gate fehlgeschlagen! Push abgebrochen.${NC}"
    exit 1
fi

echo -e "${GREEN}✅ Alle Pre-Push Checks bestanden! Code wird gepusht.${NC}"
exit 0
